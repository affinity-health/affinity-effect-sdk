{
  "name": "@affinity-health/effect-sdk",
  "version": "0.1.0",
  "description": "Effect-native TypeScript SDK for the Affinity API",
  "homepage": "https://docs.joinaffinityai.com/api",
  "bugs": {
    "url": "https://github.com/affinity-health/affinity-effect-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affinity-health/affinity-effect-sdk.git"
  },
  "bin": {
    "affinity": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./operations": {
      "types": "./dist/services/affinity.d.mts",
      "import": "./dist/services/affinity.mjs",
      "default": "./dist/services/affinity.mjs"
    },
    "./code": {
      "types": "./dist/code/index.d.mts",
      "import": "./dist/code/index.mjs",
      "default": "./dist/code/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "bun run generate:check && vp check && bun test && bun run build && bun run package:check",
    "clean": "rm -rf dist",
    "convert": "bun scripts/convert.ts",
    "generate": "bun run convert && bun scripts/generate.ts && bun scripts/generate-code.ts",
    "generate:check": "bun scripts/generate-check.ts",
    "package:check": "bun scripts/check-package.ts",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.8",
    "@effect/platform-bun": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "effect": "4.0.0-rc.112",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 || >=4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.12"
}
