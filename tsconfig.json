{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@affinity-health/effect-sdk": ["./src/index.ts"],
      "@affinity-health/effect-sdk/operations": ["./src/services/affinity.ts"]
    }
  },
  "include": ["src", "scripts", "test", "examples"]
}
